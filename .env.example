# ─── Travel Booking Aggregator – Environment Variables ───────────────────────
# Copy this file to .env and fill in your actual values.
# The .env file is .gitignored and will NOT be committed.

# MySQL configuration
DB_URL=jdbc:mysql://localhost:3306/travel_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=travelapp
DB_PASSWORD=your_password_here

# Optional: set to true in dev to force refresh demo journeys on startup
APP_SEED_FORCE_REFRESH=false
